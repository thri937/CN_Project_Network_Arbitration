###############################################################################
# Frontend configuration
#
# Copy to `.env.local` for development, or `.env.production` for a build.
#
# EVERY VARIABLE IS OPTIONAL. With none set, the SPA proxies the API to
# localhost:4000 and offers development sign-in against the backend's dev auth
# adapter — so the platform is usable immediately with no cloud project.
###############################################################################

# Absolute backend URL. Required in PRODUCTION; in development the Vite proxy
# handles /api, so leaving it unset is correct and keeps requests same-origin.
# VITE_API_PREFIX=https://your-backend.onrender.com/api/v1

###############################################################################
# Firebase web configuration
#
# From Project settings → Your apps → Web app.
#
# When these are absent the sign-in screen detects it and offers development
# sign-in instead. Set them together with the backend's AUTH_DRIVER=firebase —
# configuring one side without the other produces a sign-in that succeeds
# against the provider and is then rejected by the API.
###############################################################################

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
