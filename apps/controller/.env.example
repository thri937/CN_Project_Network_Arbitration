###############################################################################
# Runtime Arbitration Platform — backend configuration
#
# Copy to `.env` and adjust. Every variable is validated at process start
# (src/config/env.ts); an invalid configuration aborts the boot rather than
# failing later at an arbitrary call site.
###############################################################################

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info
LOG_PRETTY=true

# Comma-separated allow-list. The Vite dev server runs on 5173, preview on 4173.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

###############################################################################
# ADAPTER SELECTION — the hexagonal swap points.
#
# Change these to re-wire the composition root. No other file changes.
#
#   DATASTORE_DRIVER    firestore | memory
#   AUTH_DRIVER         firebase  | dev
#   TELEMETRY_PROVIDER  synthetic | open5gs | free5gc | kubernetes
#
# `memory` and `dev` exist so the platform is fully runnable and CI-testable
# without cloud credentials. Both are rejected at boot when NODE_ENV=production.
###############################################################################

DATASTORE_DRIVER=memory
AUTH_DRIVER=dev
TELEMETRY_PROVIDER=synthetic

###############################################################################
# Firebase (required when DATASTORE_DRIVER=firestore or AUTH_DRIVER=firebase)
#
# Either supply the three inline values from your service-account JSON, or point
# GOOGLE_APPLICATION_CREDENTIALS at the file, or run against the emulator.
# The private key may contain literal \n escapes — they are unescaped at load.
###############################################################################

# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FIRESTORE_EMULATOR_HOST=localhost:8080

###############################################################################
# Session tokens
#
# Firebase ID tokens are exchanged once at login for a backend-issued session
# JWT, so the 2-second telemetry poll does not incur remote token verification.
# MUST be overridden in production (>= 32 chars).
###############################################################################

JWT_SECRET=dev-only-insecure-secret-change-me-in-production!!
JWT_ISSUER=sentinel-arbitration
JWT_AUDIENCE=sentinel-dashboard
JWT_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=1209600

###############################################################################
# Local persisted datastore (DATASTORE_DRIVER=memory)
###############################################################################

MEMORY_STORE_DIR=./.data
MEMORY_STORE_PERSIST=true
MEMORY_STORE_FLUSH_MS=1500

###############################################################################
# Modelled enterprise transport capacity
###############################################################################

NETWORK_TOTAL_CAPACITY_MBPS=10000
NETWORK_RESERVED_CAPACITY_MBPS=500

###############################################################################
# Background jobs
###############################################################################

ENABLE_JOBS=true
TELEMETRY_TICK_MS=2000
CAPACITY_TICK_MS=2000
CONTENTION_SCAN_MS=2000
RECOVERY_SCAN_MS=5000
RETENTION_SWEEP_MS=900000
AUTO_ARBITRATION=true

TELEMETRY_PERSIST=true
TELEMETRY_PERSIST_EVERY_N_TICKS=5

###############################################################################
# HTTP hardening
###############################################################################

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT=256kb
TRUST_PROXY=true

###############################################################################
# Realtime & documentation
###############################################################################

ENABLE_SOCKET_IO=true
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

###############################################################################
# Bootstrap — the first user with this email becomes ADMIN on first login.
# Without it, a fresh deployment has no way to obtain an administrator.
###############################################################################

# BOOTSTRAP_ADMIN_EMAIL=you@example.com
