###############################################################################
# Real Network Arbitration Testbed Configuration
###############################################################################

# Controller
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info
LOG_PRETTY=true

DATASTORE_DRIVER=memory
AUTH_DRIVER=dev
TELEMETRY_PROVIDER=gateway          # synthetic = offline simulator from SOURCE
NETWORK_TOTAL_CAPACITY_MBPS=1000    # testbed unit is kbps -> 1000 = 1 Mbps (set 8000 for 1 MB/s)
NETWORK_RESERVED_CAPACITY_MBPS=50
BANDWIDTH_UNIT=kbps
AUTO_ARBITRATION=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
GATEWAY_URL=http://127.0.0.1:9090
GATEWAY_TOKEN=change-me-long-random-gateway-token-sec-2026

# Session tokens
JWT_SECRET=dev-only-insecure-secret-change-me-in-production-testbed-key!
JWT_ISSUER=sentinel-arbitration
JWT_AUDIENCE=sentinel-dashboard
JWT_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=1209600

# Local datastore
MEMORY_STORE_DIR=./.data
MEMORY_STORE_PERSIST=true
MEMORY_STORE_FLUSH_MS=1500

# Background jobs
ENABLE_JOBS=true
TELEMETRY_TICK_MS=2000
CAPACITY_TICK_MS=2000
CONTENTION_SCAN_MS=2000
RECOVERY_SCAN_MS=5000
RETENTION_SWEEP_MS=900000
TELEMETRY_PERSIST=true
TELEMETRY_PERSIST_EVERY_N_TICKS=5

# HTTP hardening
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT=256kb
TRUST_PROXY=true

# Realtime & documentation
ENABLE_SOCKET_IO=true
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Gateway
GATEWAY_LAN_PORT=8080
GATEWAY_PROXY_PORT=8888
GATEWAY_PROXY_ENABLED=false
GATEWAY_SOUTHBOUND_PORT=9090
GATEWAY_TICK_MS=20
GATEWAY_QUEUE_SECONDS=0.5
INTERNET_SOURCE_URL=https://speed.cloudflare.com/__down?bytes=25000000
CONTROLLER_URL=http://127.0.0.1:4000
